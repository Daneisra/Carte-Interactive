# Normaliser les fins de ligne
* text=auto eol=lf

# Traiter ces fichiers comme texte (diff corrects)
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Git LFS pour les binaires lourds audio
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
assets/map.png filter=lfs diff=lfs merge=lfs -text
